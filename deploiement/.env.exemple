# Copier en .env sur le serveur et remplir. Ne jamais envoyer ce fichier dans Git ni le coller dans une IA.
LWS_LOGIN=LWS-XXXXXX
LWS_CLE=
# Mot de passe de l'adresse du connecteur : 32 caractères au hasard (commande : openssl rand -hex 16)
MCP_JETON=
LWS_DOMAINES_MODIFIABLES=agence-elite.fr
# Mettre 1 pour utiliser la clé de test LWS
LWS_MODE_TEST=0
